# Copy to .env.local and fill in. Restart the dev server afterward —
# Vite only reads env files at startup.
#
# Both values are safe in a client bundle: the anon key is public by design,
# and row level security is what protects the data. Never put the service_role
# key in a VITE_ variable — anything VITE_-prefixed ships to the browser.

VITE_SUPABASE_URL=https://irjgefdsllshzzqxzful.supabase.co
VITE_SUPABASE_ANON_KEY=
